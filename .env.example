# Copy to .env for local development: cp .env.example .env
# Phase 0 minimal set (packages/config/env.ts) — grows per-phase.

NODE_ENV=development

# Postgres (docker-compose.yml's postgres service reads these directly too)
POSTGRES_DB=bts_erp_dev
POSTGRES_USER=bts_app
POSTGRES_PASSWORD=bts_dev_password
DATABASE_URL=postgresql://bts_app:bts_dev_password@localhost:5432/bts_erp_dev

# Redis
REDIS_URL=redis://localhost:6379

# App ports
API_PORT=4000
WEB_PORT=3000

# Used by apps/web (src/app/page.tsx) to reach the API server-side.
# Inside Docker Compose this is overridden to http://api:4000 (see
# docker-compose.yml's web service); this default is for running
# `npm run dev` on the host without Docker.
API_INTERNAL_URL=http://localhost:4000

# Phase 2 — Identity & RBAC. Generate real random secrets for anything
# beyond local dev, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-before-any-real-deployment
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-before-any-real-deployment
JWT_MFA_SECRET=dev-only-mfa-secret-change-me-before-any-real-deployment
JWT_MFA_ENROLLMENT_SECRET=dev-only-mfa-enrollment-secret-change-me-before-any-real-deployment

# --- Not yet needed — placeholders for what's coming ---
# SSLCOMMERZ_STORE_ID=          # Phase 7 — payment gateway (prd.md §14: still unconfirmed which provider)
# SMS_GATEWAY_API_KEY=          # still unconfirmed which provider (prd.md §14)
