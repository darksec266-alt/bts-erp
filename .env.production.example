# Template only — copy to .env.production on the actual VPS and fill in
# real values there; never commit the real .env.production file.
# Mirrors docs/production_postgresql_pgadmin_prisma_secure_setup.md's
# secrets-handling guidance (§2 — env vars / secrets manager, never baked
# into an image).

NODE_ENV=production

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://__user__:__password__@postgres:5432/__db__

REDIS_URL=redis://redis:6379

API_PORT=4000
WEB_PORT=3000
